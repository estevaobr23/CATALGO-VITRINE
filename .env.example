# ── Supabase (públicas: vão para o navegador) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública do site (sem barra no final). Usada no link da vitrine,
# nos e-mails de confirmação e no preview do WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Checkout Cakto (PENDENTE: cole os links reais das ofertas) ───────────
NEXT_PUBLIC_CHECKOUT_URL_INICIANTE=
NEXT_PUBLIC_CHECKOUT_URL_PROFISSIONAL=

# E-mail de suporte exibido no painel (opcional)
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Conta de demonstração (só para os scripts, não vai para o navegador) ─
# Usada por scripts/seed-demo.mjs, seed-demo-sections.mjs, import-images.mjs
# e capture-prints.mjs para entrar como lojista e montar a vitrine de
# exemplo "Encanto Cestas" (/vitrine/encanto-cestas).
# Crie essa conta em /cadastro e dê a ela um direito ativo ao cestavitrine.
DEMO_EMAIL=
DEMO_PASSWORD=

# ── NUNCA coloque aqui ───────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY e CAKTO_WEBHOOK_SECRET ficam SÓ nos secrets da
# Edge Function (Supabase → Edge Functions → Secrets). O app Next não usa.
